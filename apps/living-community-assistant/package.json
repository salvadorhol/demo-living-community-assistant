{
  "name": "@living-community-assistant/living-community-assistant",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "dependencies": {
    "@living-community-assistant/types": "*",
    "firebase": "^13.1.0",
    "socket.io-client": "^4.8.1"
  },
  "nx": {
    "name": "living-community-assistant",
    "targets": {
      "build": {
        "cache": false
      },
      "local-emulator": {
        "executor": "nx:run-commands",
        "cache": false,
        "continuous": true,
        "options": {
          "commands": [
            "node tools/dev.mjs"
          ],
          "parallel": false
        },
        "dependsOn": [
          {
            "projects": [
              "functions"
            ],
            "target": "build"
          }
        ]
      },
      "deploy": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "typecheck",
          "build"
        ],
        "options": {
          "command": "node tools/deploy.mjs hosting",
          "cwd": "{workspaceRoot}",
          "tty": true
        }
      }
    }
  }
}
