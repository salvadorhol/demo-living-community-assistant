{
  "name": "socket-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/socket-server/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build", "typecheck"],
      "inputs": ["production", "^production", "{workspaceRoot}/.nvmrc"],
      "outputs": ["{workspaceRoot}/apps/socket-server/dist"],
      "options": {
        "command": "esbuild apps/socket-server/src/main.ts --bundle --platform=node --target=node24 --packages=external --format=cjs --outfile=apps/socket-server/dist/main.cjs --sourcemap"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "command": "node --env-file-if-exists=apps/socket-server/.env --watch --watch-preserve-output --unhandled-rejections=strict apps/socket-server/src/main.ts"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "command": "nx serve socket-server"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "command": "node --env-file-if-exists=apps/socket-server/.env apps/socket-server/dist/main.cjs"
      }
    },
    "local-emulator": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "command": "node --env-file-if-exists=apps/socket-server/.env --watch --watch-preserve-output --unhandled-rejections=strict apps/socket-server/src/main.ts",
        "env": {
          "FIREBASE_PROJECT_ID": "demo-living-community-assistant",
          "FIREBASE_AUTH_EMULATOR_HOST": "127.0.0.1:9099",
          "FIRESTORE_EMULATOR_HOST": "127.0.0.1:8080",
          "FIREBASE_STORAGE_EMULATOR_HOST": "127.0.0.1:9199",
          "FIREBASE_STORAGE_BUCKET": "demo-living-community-assistant.firebasestorage.app"
        }
      }
    }
  }
}
