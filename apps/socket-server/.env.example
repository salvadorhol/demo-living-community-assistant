HOST=127.0.0.1
PORT=3000
# Comma-separated browser origins. Clients without an Origin header are also allowed.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Required: must match the frontend Firebase project.
FIREBASE_PROJECT_ID=demo-living-community-assistant
# Local only. Remove for production, which uses application default credentials.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Required for live voice. Keep this key on the socket server only.
OPENAI_API_KEY=
# Production: set to Terraform's recordings_bucket output.
# Local emulator target supplies these automatically.
# FIREBASE_STORAGE_BUCKET=your-project-call-recordings
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
MAX_CALL_MS=3600000

# Defaults: info; readable locally, JSON in production/CI.
# Use NODE_ENV=production with production deployments (pino-pretty is dev-only).
LOG_LEVEL=info
# LOG_FORMAT=json

# Assistant output buffer in milliseconds: default 60 seconds, range 1000–120000.
# Exceeding this cancels the current reply while keeping the call active.
VOICE_OUTPUT_QUEUE_MS=60000

# Firebase-backed voice tools. Local-emulator targets set the emulator host automatically.
FIREBASE_FUNCTIONS_REGION=us-central1
# FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
# For deployed private functions, omit emulator hosts and use the socket runtime's
# Google service-account identity with roles/run.invoker on both function services.
