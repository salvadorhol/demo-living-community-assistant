rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /appConfig/sophiePrompt {
      function isAdmin() {
        return request.auth != null && request.auth.token.admin == true;
      }
      function validPrompt() {
        let data = request.resource.data;
        return data.keys().hasAll(['content', 'revision', 'updatedAt', 'updatedBy'])
          && data.keys().hasOnly(['content', 'revision', 'updatedAt', 'updatedBy'])
          && data.content is string && data.content.size() > 0 && data.content.size() <= 50000
          && data.content.matches('(?s).*[^\\s].*')
          && data.revision is int && data.revision >= 1 && data.revision <= 9007199254740991
          && data.updatedBy == request.auth.uid
          && data.updatedAt == request.time;
      }
      allow get: if isAdmin();
      allow create: if isAdmin() && validPrompt() && request.resource.data.revision == 1;
      allow update: if isAdmin() && validPrompt() && request.resource.data.revision == resource.data.revision + 1;
      allow list, delete: if false;
    }
    match /appConfig/appointments {
      function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
      function validConfiguration() {
        let data = request.resource.data;
        return data.keys().hasAll(['slots', 'revision', 'updatedAt', 'updatedBy'])
          && data.keys().hasOnly(['slots', 'revision', 'updatedAt', 'updatedBy'])
          && data.slots is list && data.slots.size() <= 20
          && data.revision is int && data.revision >= 1 && data.revision <= 9007199254740991
          && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
      }
      allow get: if isAdmin();
      allow create: if isAdmin() && validConfiguration() && request.resource.data.revision == 1;
      allow update: if isAdmin() && validConfiguration() && request.resource.data.revision == resource.data.revision + 1;
      allow list, delete: if false;
    }
    match /sessions/{uid} {
      allow read: if request.auth != null && request.auth.token.appAccess == true && request.auth.uid == uid;
      allow write: if false;
      match /followUpRequests/{requestId} {
        allow read: if request.auth != null && request.auth.token.appAccess == true && request.auth.uid == uid;
        allow write: if false;
      }
      match /calls/{callId} {
        allow read: if request.auth != null && request.auth.token.appAccess == true && request.auth.uid == uid;
        allow write: if false;
        match /transcripts/{utteranceId} {
          allow read: if request.auth != null && request.auth.token.appAccess == true && request.auth.uid == uid;
          allow write: if false;
        }
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
