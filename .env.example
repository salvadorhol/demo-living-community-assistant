# Created interactively when a deployment or Terraform plan needs a project.
GCP_PROJECT_ID=
# Optional; defaults to GCP_PROJECT_ID. Must be a globally available Hosting site ID.
FIREBASE_HOSTING_SITE_ID=
# Match an existing project's immutable Firestore database location.
FIRESTORE_LOCATION_ID=
# Preserve an existing Hosting site's linked Firebase web app.
FIREBASE_HOSTING_APP_ID=
# Bucket and database locations can differ.
RECORDINGS_LOCATION_ID=us-central1
# Match existing protection during import; enable separately when desired.
FIRESTORE_DELETE_PROTECTION_STATE=DELETE_PROTECTION_ENABLED
# Disable if the Functions runtime does not need database access.
FUNCTIONS_FIRESTORE_ACCESS=true
SOCKET_SERVICE_ACCOUNT=
